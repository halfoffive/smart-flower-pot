{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Flower Pot Control Software",
  "version": "4.3.2",
  "identifier": "com.smart-flower-pot.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智能花盆",
        "width": 480,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["smart-flower-pot"]
      },
      "mobile": [
        { "host": "connect" }
      ]
    }
  }
}
